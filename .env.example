# ============================================
# CunMail 配置文件
# ============================================

# ---- 必需配置 ----
# D1 数据库名称（你在 Cloudflare 上创建的 D1 数据库名）
D1_DATABASE_NAME=cunmail
# D1 数据库 ID（在 Cloudflare 控制台查看）
D1_DATABASE_ID=replace-with-d1-database-id

# 邮箱域名（你要用来收邮件的域名，多个用逗号分隔）
EMAIL_DOMAIN=example.com

# Cookie 加密密钥（随便填一串随机字符，越长越安全）
COOKIES_SECRET=replace-with-a-random-secret-string

# ---- 可选配置 - 人机验证 ----
# Cloudflare Turnstile 人机验证（不填则关闭验证）
TURNSTILE_KEY=
TURNSTILE_SECRET=

# ---- 可选配置 - 站点密码 ----
# 站点访问密码（不填则公开访问）
PASSWORD=

# ---- 可选配置 - 发邮件功能 ----
# 发送通道：resend / mailchannels / cloudflare（默认 resend，免费可用）
# cloudflare 通道需要 Cloudflare Pro 版（$5/月），免费版用不了
SEND_CHANNEL=resend
# 发件人邮箱（开启发邮件功能时必填，必须是已验证的域名邮箱）
SENDER_EMAIL=no-reply@example.com
# Mailbox Token 密钥（开启发邮件功能时必填，随机字符串）
MAILBOX_TOKEN_SECRET=
# Resend API Key（用 resend 通道时填，免费版 100 封/天）
RESEND_API_KEY=
# MailChannels API Key（用 mailchannels 通道时填）
MAILCHANNELS_API_KEY=
# 每个邮箱每分钟发送限制（默认 3）
SEND_RATE_LIMIT_PER_MINUTE=3
# 每个 IP 每分钟发送限制（默认 10）
SEND_IP_RATE_LIMIT_PER_MINUTE=10

# ---- 可选配置 - 其他 ----
# API 调用频率限制（每分钟，默认 100）
API_RATE_LIMIT_PER_MINUTE=100
# 是否显示推广链接（默认 false）
SHOW_AFF=false
# 是否开启 OpenAPI（默认 false）
ENABLE_OPENAPI=false
